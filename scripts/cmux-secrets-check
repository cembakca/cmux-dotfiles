#!/bin/zsh

set -u

# Git'e staged edilmis dosyalarda yaygin secret/token formatlarini ara.
# Eslesen secret degerini ASLA ekrana basma; sadece dosya adini goster.

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Bir git reposu icinde degilsin."
  exit 2
fi

patterns=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'sk-[A-Za-z0-9_-]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'npm_[A-Za-z0-9]{20,}'
  '-----BEGIN ([A-Z0-9]+ )?PRIVATE KEY-----'
)

args=()

for pattern in "${patterns[@]}"; do
  args+=(-e "$pattern")
done

matches="$(
  git grep \
    --cached \
    -I \
    -l \
    -E \
    "${args[@]}" \
    -- \
    2>/dev/null
)"

if [ -n "$matches" ]; then
  echo
  echo "Potential secret detected in staged files:"
  echo

  while IFS= read -r file; do
    echo "  - $file"
  done <<< "$matches"

  echo
  echo "Commit blocked."
  echo "Dosyalari kontrol et ve secret'i staged content'ten kaldir."
  echo

  exit 1
fi

echo "Secret scan passed."
exit 0
